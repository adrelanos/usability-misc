#set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## Runs at package build time, where helper-scripts is deliberately not a
## build dependency, so 'has' from helper-scripts is unavailable here.
## style-ok: no-has

true "$0: START"

mydir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "${mydir}"
cd ..
cd ..
cd ..

command -v sha512sum >/dev/null

hashsum_old="$(sha512sum ./usr/share/usability-misc/dist-installer-cli-standalone)"

./usr/share/usability-misc/build-dist-installer-cli

hashsum_new="$(sha512sum ./usr/share/usability-misc/dist-installer-cli-standalone)"

if [ ! "${hashsum_old}" = "${hashsum_new}" ]; then
  printf '%s\n' \
    "$0: old: '${hashsum_old}'" \
    "$0: new: '${hashsum_new}'" \
    "$0: ERROR: ./usr/share/usability-misc/dist-installer-cli-standalone has not been rebuilt. Run:" \
    "./usr/share/usability-misc/build-dist-installer-cli"
  exit 1
fi

true "$0: END"
